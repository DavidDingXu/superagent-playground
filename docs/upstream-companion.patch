new file mode 100644
index 0000000..4979c3c
--- /dev/null
+++ b/tests/cross-channel-replay.spec.ts
@@ -0,0 +1,126 @@
+/** A credential-free replay of one task crossing IM and GitHub. External services and model decisions are scripted. */
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, it } from 'vitest'
+import { Engine, latestAssignment, ticketOutcome, type Candidate, type OutboundMessage, type Policy, type Trigger } from '../src/core/index.ts'
+import { Store } from '../src/app/store.ts'
+
+it('keeps one persisted ticket across an IM request, GitHub review, restart and merge, without reevaluating subscribed follow-ups', () => {
+  const directory = mkdtempSync(join(tmpdir(), 'superagent-replay-'))
+  const path = join(directory, 'state.sqlite')
+  let store = new Store(path)
+  const candidates: Candidate[] = []
+  const starts: { ticketId: string; assignmentId: string }[] = []
+  const deliveries: { ticketId: string; assignmentId: string; inputIds: string[] }[] = []
+  const policy: Policy = {
+    version: 'replay-v1', paused: false, evalTimeoutMs: 60_000,
+    gate: trigger => trigger.human && trigger.actor.id === 'maintainer'
+      ? { admissible: true, strength: 'explicit', basis: { via: 'listed' } }
+      : { admissible: false, reason: 'not allowed' },
+    revalidate: () => true, admitsInferred: () => false,
+  }
+  let clock = 0
+  const engineFor = () => new Engine({
+    repo: store, policy: () => policy,
+    scope: { scope: () => ({ listened: true, observed: false }) },
+    assessor: { request: candidate => { candidates.push(candidate) } },
+    // These ports record dispatch only: this replay neither runs a model nor changes a GitHub repository.
+    executor: {
+      start: (ticket, assignment) => { starts.push({ ticketId: ticket.id, assignmentId: assignment.id }) },
+      deliver: (ticket, assignment) => { deliveries.push({ ticketId: ticket.id, assignmentId: assignment.id, inputIds: [...ticket.undelivered] }) },
+      stop: () => {},
+    },
+    outbox: {
+      send: message => { store.receipts.add(message) },
+      status: id => store.replyStatus(id), withdraw: id => { store.receipts.withdraw(id) },
+    },
+    now: () => new Date(Date.UTC(2026, 10, 1, 0, 0, clock++)).toISOString(),
+  })
+  const trigger = (id: string, source: string, thread: string, text: string): Trigger => ({
+    id, source, threads: [{ source, id: thread }], actor: { source, id: 'maintainer' }, human: true,
+    addressed: 'mention', text, at: '2026-11-01T00:00:00.000Z', meta: {},
+    channel: { source, thread: `${source}:${thread}`, address: { thread } },
+  })
+  try {
+    let engine = engineFor()
+    const request = trigger('im-request-1', 'im', 'appearance', 'Allow separate fonts for body, code and terminal.')
+    expect(engine.receive(request)).toBe('stored')
+    expect(engine.receive(request)).toBe('duplicate')
+    engine.evaluateDue()
+    expect(candidates).toHaveLength(1)
+    const candidate = candidates[0]!
+    engine.decide(request.id, { evalId: candidate.evalId, kind: 'accept', title: 'Separate appearance fonts',
+      scope: 'Appearance settings only', reason: 'Explicit request', acknowledgement: 'Working on the font settings.' })
+    const ticketId = store.tickets.list()[0]!.id
+    let assignmentId = latestAssignment(store.tickets.get(ticketId)!)!.id
+    expect(starts).toEqual([{ ticketId, assignmentId }])
+    engine.assignmentStarted(ticketId, assignmentId)
+    // Advance the scripted executor only after the Engine has actually requested each boundary operation.
+    const readDelivery = (requiredInput?: string) => {
+      const dispatched = deliveries.at(-1)
+      expect(dispatched).toMatchObject({ ticketId, assignmentId })
+      expect(dispatched!.inputIds.length).toBeGreaterThan(0)
+      if (requiredInput) expect(dispatched!.inputIds).toContain(requiredInput)
+      engine.inputsDelivered(ticketId, assignmentId, dispatched!.inputIds)
+      engine.inputsRead(ticketId, dispatched!.inputIds)
+    }
+    // The initial request is part of the start assignment, not a separately delivered follow-up Input.
+    engine.bindThread(ticketId, { source: 'github', id: 'pull/42' }, true)
+
+    const review = trigger('github-review-1', 'github', 'pull/42', 'Keep the extra font settings collapsed.')
+    engine.receive(review)
+    engine.evaluateDue()
+    expect(store.triggers.disposition(review.id)?.fanout).toEqual([ticketId])
+    expect(candidates).toHaveLength(1)
+    const input = store.tickets.get(ticketId)!.inputs.find(item => item.kind === 'trigger' && item.triggerId === review.id)!
+    readDelivery(input.id)
+
+    // Reopen the actual SQLite file, rebuilding the Engine rather than carrying in-memory task state over.
+    store.close()
+    store = new Store(path)
+    engine = engineFor()
+    expect(store.tickets.list()).toHaveLength(1)
+    engine.assignmentInterrupted(ticketId, assignmentId)
+    const recovered = latestAssignment(store.tickets.get(ticketId)!)!
+    expect(recovered.id).not.toBe(assignmentId)
+    assignmentId = recovered.id
+    expect(starts).toHaveLength(2)
+    expect(starts.at(-1)).toEqual({ ticketId, assignmentId })
+    engine.assignmentStarted(ticketId, assignmentId)
+    const recoveryInput = store.tickets.get(ticketId)!.inputs.findLast(item => item.kind === 'text')
+    expect(recoveryInput).toBeDefined()
+    readDelivery(recoveryInput!.id)
+    expect(engine.receive(review)).toBe('duplicate')
+    const followup = trigger('im-followup-1', 'im', 'appearance', 'Also allow a separate terminal font size.')
+    engine.receive(followup)
+    engine.evaluateDue()
+    expect(store.triggers.disposition(followup.id)?.fanout).toEqual([ticketId])
+    expect(candidates).toHaveLength(1)
+    const followupInput = store.tickets.get(ticketId)!.inputs.find(item => item.kind === 'trigger' && item.triggerId === followup.id)!
+    readDelivery(followupInput.id)
+    engine.report(ticketId, { state: 'ready', summary: 'Scripted executor reports the requested changes ready.' })
+    expect(store.tickets.get(ticketId)!.ended).toBeUndefined()
+    engine.threadClosed({ source: 'github', id: 'pull/42' }, 'merged', '2026-11-01T00:01:00.000Z')
+    expect(ticketOutcome(store.tickets.get(ticketId)!)).toBe('merged')
+    const reply = { purpose: 'result' as const, ticketId, text: 'Pull request merged.' }
+    const first = engine.reply(reply)
+    expect(engine.reply(reply)).toMatchObject({ id: first.id, reused: true })
+    const result = store.receipts.get(first.id) as OutboundMessage
+    expect(result.channel).toMatchObject({ source: 'im', thread: 'im:appearance' })
+    expect(store.tickets.list()).toHaveLength(1)
+    const evidence = {
+      mode: 'deterministic-local-replay', modelCalls: 0, externalWrites: 0,
+      databaseReopened: true, ticketCount: store.tickets.list().length, assessmentCount: candidates.length,
+      assignmentCount: store.tickets.get(ticketId)!.assignments.length,
+      subscribedFollowups: [review.id, followup.id].map(id => ({ id, tickets: store.triggers.disposition(id)?.fanout })),
+      finalOutcome: ticketOutcome(store.tickets.get(ticketId)!), queuedReplySource: result.channel.source,
+      duplicateResultReused: true, startRequests: starts.length, dispatches: deliveries.length,
+    }
+    // Optional evidence export for article reproduction; no account information or credentials are present.
+    if (process.env.SUPERAGENT_REPLAY_REPORT) writeFileSync(process.env.SUPERAGENT_REPLAY_REPORT, JSON.stringify(evidence, null, 2) + '\n')
+  } finally {
+    store.close()
+    rmSync(directory, { recursive: true, force: true })
+  }
+})
